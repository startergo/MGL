# Copy to agents/.env (git-ignored) or export in your shell profile. Never commit real values.
# Load with:  set -a; . agents/.env; set +a

# --- LLM -------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# ANTHROPIC_AUTH_TOKEN=<token for an Anthropic-compatible gateway>
# ANTHROPIC_BASE_URL=<https://gateway.example/anthropic>
# AGENT_MODEL=claude-opus-5-5
# AGENT_REASONING_EFFORT=high

# --- Paths (all optional; defaults are relative to the repository) ----------
# MGL_PROJECT_DIR=<path to the MGL checkout>     # default: parent of agents/
# MGL_BUILD_DIR=<build output dir>               # default: $MGL_PROJECT_DIR/build
# MGL_REPORTS_DIR=<report dir>                   # default: $MGL_BUILD_DIR/_reports
# MGL_WORKTREE_ROOT=<where domain worktrees go>  # default: $MGL_PROJECT_DIR/wt

# --- Limits ----------------------------------------------------------------
# MGL_MAKE_JOBS=8
# MGL_BUILD_TIMEOUT=1800
# MGL_TEST_TIMEOUT=900
