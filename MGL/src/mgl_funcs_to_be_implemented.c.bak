void mglTexStorage2DMultisample(GLMContext ctx, GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height, GLboolean fixedsamplelocations)
{
    // For multisample textures, create a regular 2D texture
    // Metal will handle actual MSAA during rendering
    // Use mglTexImage2D with NULL data to allocate storage
    fprintf(stderr, "MGL: mglTexStorage2DMultisample called - target=0x%x, samples=%d, format=0x%x, %dx%d\n", 
            target, samples, internalformat, width, height);
    
    // Allocate texture storage using TexImage2D
    mglTexImage2D(ctx, target, 0, internalformat, width, height, 0, internalformat, GL_UNSIGNED_BYTE, NULL);
}

